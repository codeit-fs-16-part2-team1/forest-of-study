// 공부의 숲 DB 설계 v0.9 — docs/DB.md / ADR-051~058
// 문서용 스키마 초안. 연결·생성·migration 실행 없음.
// 비밀번호는 보호 요청마다 bcrypt 검증. 토큰·타이머 키·PointHistory 테이블 없음.
// docs/DB.md의 CHECK·RUNNING/PAUSED 부분 UNIQUE는 후속 migration에서 적용한다.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChallengeStatus {
  RUNNING
  PAUSED
  COMPLETED
  RESET
}

model Study {
  id            String   @id @default(uuid()) @db.Uuid
  // trim 후 그래핌 기준 1~10 / 1~15 / 1~100개를 서버에서 검사한다.
  nickname      String   @db.Text
  name          String   @db.Text
  introduction  String   @db.Text
  backgroundKey String   @default("green") @db.Text
  passwordHash  String   @db.Text
  points        Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  routines   Routine[]
  challenges Challenge[]
  reactions  Reaction[]

  @@index([createdAt, id])
  @@index([points, id])
}

model Routine {
  id        String    @id @default(uuid()) @db.Uuid
  studyId   String    @db.Uuid
  // trim 후 그래핌 기준 1~20개를 서버에서 검사한다.
  name      String    @db.Text
  // 서버가 한국 날짜를 지정한다. UTC 날짜를 기본값으로 쓰지 않는다.
  startsOn  DateTime  @db.Date
  // 종료일은 기록 표시에 포함한다. endsOn이 있으면 목록에서 숨기고 조작을 막는다.
  endsOn    DateTime? @db.Date
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  study   Study            @relation(fields: [studyId], references: [id], onDelete: Cascade)
  history RoutineHistory[]

  @@index([studyId, startsOn, endsOn])
}

model RoutineHistory {
  routineId  String   @db.Uuid
  recordDate DateTime @db.Date
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@id([routineId, recordDate])
}

model Challenge {
  id                  String          @id @default(uuid()) @db.Uuid
  studyId             String          @db.Uuid
  goalMinutes         Int             @default(10)
  status              ChallengeStatus @default(RUNNING)
  // 이전 실행 구간에서 확정한 누적 시간. 진행 중 구간은 서버 시각으로 파생한다.
  elapsedMilliseconds Int             @default(0)
  // 현재 실행 구간의 시작 시각. PAUSED/RESET/COMPLETED에서는 null.
  lastStartedAt       DateTime?       @db.Timestamptz(3)
  // 목표 완료 시에만 지급. Study.points 증가와 같은 트랜잭션으로 저장한다.
  awardedPoints       Int             @default(0)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)

  study Study @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId, status])
  @@index([studyId, createdAt, id])
}

model Reaction {
  studyId   String   @db.Uuid
  // 응원용 식별자. 타이머 조작권이나 인증 증명으로 사용하지 않는다.
  browserId String   @db.Uuid
  emoji     String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  study Study @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@id([studyId, browserId, emoji])
  @@index([studyId, emoji])
}
