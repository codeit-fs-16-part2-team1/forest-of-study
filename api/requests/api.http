Accept: application/json
Content-Type: application/json

{
  "password": " Forest123!"
}

### 킥오프 — 임시 배경 목록 밖 키 거절
# 400 INVALID_BACKGROUND. backgroundKey를 담당자가 공유한 임시8종 목록에 없는 값으로 지정.
POST {{baseUrl}}/studies
Accept: application/json
Content-Type: application/json

{
  "nickname": "연우",
  "name": "개발공장",
  "introduction": "매일 공부해요",
  "password": "{{studyPassword}}",
  "passwordConfirm": "{{studyPassword}}",
  "backgroundKey": "unknown-background"
}

