# @ref routineCreate
PUT {{baseUrl}}/studies/{{missingStudyId}}/routines/{{routineId}}/check
X-Study-Password: {{password}}
Content-Type: application/json

{"recordDate":"{{todayDate}}","completed":true}

### 28 API-HB-05 없는 습관 — 404 ROUTINE_NOT_FOUND
# @ref routineCreate
PUT {{baseUrl}}/studies/{{studyId}}/routines/{{missingRoutineId}}/check
X-Study-Password: {{password}}
Content-Type: application/json

{"recordDate":"{{todayDate}}","completed":true}

### 29 API-HB-05 다른 스터디 소속 습관 — 404 ROUTINE_NOT_FOUND
# 다른 스터디의 실제 시드 습관을 조작한다.
# @ref routineCreate
PUT {{baseUrl}}/studies/{{studyId}}/routines/{{otherStudyRoutineId}}/check
X-Study-Password: {{password}}
Content-Type: application/json

{"recordDate":"{{todayDate}}","completed":true}

### 30 API-HB-05 시드 종료 습관 체크 — 409 ROUTINE_ENDED
# 종료일 기록은 그대로 보존되어야 한다.
# @ref routineCreate
PUT {{baseUrl}}/studies/{{historyStudyId}}/routines/{{endedRoutineId}}/check
X-Study-Password: {{password}}
Content-Type: application/json

{"recordDate":"{{todayDate}}","completed":true}

### 31 API-HB-05 시드 종료 습관 해제 — 409 ROUTINE_ENDED
# @ref routineCreate
PUT {{baseUrl}}/studies/{{historyStudyId}}/routines/{{endedRoutineId}}/check
X-Study-Password: {{password}}
Content-Type: application/json

{"recordDate":"{{todayDate}}","completed":false}

### 32 API-HB-05 오래된 화면 날짜 — 409 DATE_CHANGED
# pastDate는 서버 오늘과 다른 날짜로 둔다.
# @ref routineCreate
PUT {{baseUrl}}/studies/{{studyId}}/routines/{{routineId}}/check
X-Study-Password: {{password}}
Content-Type: application/json

{"recordDate":"{{pastDate}}","completed":true}

