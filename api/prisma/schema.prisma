// 공부의 숲 DB 설계 v0.6 — DB.md / ADR-043~048
// 문서용 스키마 초안. 연결·생성·migration 실행 없음.
// VerificationToken 테이블 없음. 일반 인증은 서명 토큰, 타이머 조작은 전용 키 해시.
// DB.md의 CHECK·RUNNING/PAUSED 부분 UNIQUE는 후속 migration에서 적용한다.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChallengeStatus {
  RUNNING
  PAUSED
  COMPLETED
  RESET
}

enum PointKind {
  ELAPSED
  GOAL
}

model Study {
  id            String   @id @default(uuid()) @db.Uuid
  nickname      String   @db.VarChar(10)
  name          String   @db.VarChar(15)
  introduction  String   @db.VarChar(100)
  backgroundKey String   @default("green") @db.Text
  passwordHash  String   @db.Text
  points        Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  routines   Routine[]
  challenges Challenge[]
  reactions  Reaction[]

  @@index([createdAt, id])
  @@index([points, id])
}

model Routine {
  id        String    @id @default(uuid()) @db.Uuid
  studyId   String    @db.Uuid
  name      String    @db.VarChar(20)
  // 서버가 한국 날짜를 지정한다. UTC 날짜를 기본값으로 쓰지 않는다.
  startsOn  DateTime  @db.Date
  // 종료일은 기록 표시에 포함한다. endsOn이 있으면 목록에서 숨기고 조작을 막는다.
  endsOn    DateTime? @db.Date
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  study   Study            @relation(fields: [studyId], references: [id], onDelete: Cascade)
  history RoutineHistory[]

  @@index([studyId, startsOn, endsOn])
}

model RoutineHistory {
  routineId  String   @db.Uuid
  recordDate DateTime @db.Date
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@id([routineId, recordDate])
}

model Challenge {
  id                  String          @id @default(uuid()) @db.Uuid
  studyId             String          @db.Uuid
  goalMinutes         Int             @default(10)
  status              ChallengeStatus @default(RUNNING)
  // 상태 전환마다 증가. heartbeat 자체는 증가시키지 않는다.
  stateVersion        Int             @default(1)
  elapsedMilliseconds Int             @default(0)
  lastStartedAt       DateTime?       @db.Timestamptz(3)
  lastHeartbeatAt     DateTime?       @db.Timestamptz(3)
  // 32바이트 난수 키의 SHA-256 해시. 원문 키는 저장하지 않는다.
  timerKeyHash        String?         @db.VarChar(64)
  // 종료 확정 시각. COMPLETED/RESET에서만 필수.
  endedAt             DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  study        Study          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  pointHistory PointHistory[]

  @@index([studyId, status])
  @@index([studyId, createdAt, id])
}

model PointHistory {
  challengeId String    @db.Uuid
  kind        PointKind
  // ELAPSED: 1=10분, 2=20분… 각1P. GOAL: 0, 3P.
  sequence    Int
  grantedAt   DateTime  @default(now()) @db.Timestamptz(3)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([challengeId, kind, sequence])
}

model Reaction {
  studyId   String   @db.Uuid
  // 응원용 식별자. 타이머 조작권이나 인증 증명으로 사용하지 않는다.
  browserId String   @db.Uuid
  emoji     String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  study Study @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@id([studyId, browserId, emoji])
  @@index([studyId, emoji])
}
